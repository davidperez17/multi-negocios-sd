generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String?
  description  String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  city         String?
  // Color de marca del tenant en OKLCH, sobreescribe --primary en su landing
  brandColor   String   @default("oklch(0.5 0.2 340)")
  logoUrl      String?
  // Tipos de vehículo que atiende, CSV: CAR,MOTORCYCLE,TRUCK
  vehicleTypes String   @default("CAR,MOTORCYCLE,TRUCK")
  // Servicios ofrecidos, separados por saltos de línea (MVP)
  services     String?
  schedule     String?
  // Prueba gratis (registro propio). null = taller creado a mano, sin prueba
  trialEndsAt  DateTime?
  // Plan pagado vigente hasta esta fecha; se extiende con `pnpm tenant:activate`
  paidUntil    DateTime?
  createdAt    DateTime @default(now())

  users      User[]
  customers  Customer[]
  vehicles   Vehicle[]
  workOrders WorkOrder[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  // ADMIN | STAFF
  role         String   @default("STAFF")
  // Trabajador desactivado por el ADMIN: no entra y su sesión deja de valer
  active       Boolean  @default(true)
  // Intentos fallidos de login y bloqueo temporal (anti fuerza bruta)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())

  vehicles   Vehicle[]
  workOrders WorkOrder[]

  @@index([tenantId])
}

model Vehicle {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // CAR | MOTORCYCLE | TRUCK
  type       String
  brand      String
  model      String
  year       Int?
  plate      String
  color      String?
  createdAt  DateTime @default(now())

  workOrders WorkOrder[]

  @@index([tenantId])
  @@index([customerId])
}

model WorkOrder {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  // NoAction (no Restrict): bloquea borrar cliente/vehículo con historial, pero
  // deja que el borrado en cascada del tenant complete (se valida al final del statement)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: NoAction)
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: NoAction)
  // Código público que el cliente usa para consultar, p.ej. "TX-4F8K2M"
  trackingCode String    @unique
  // PIN de 5 dígitos que protege el detalle de costos en la página pública
  costCode     String
  // Intentos fallidos de PIN y bloqueo temporal (anti fuerza bruta)
  pinFailures    Int       @default(0)
  pinLockedUntil DateTime?
  // Motivo de ingreso / falla reportada
  concern      String
  diagnosis    String?
  // RECEIVED | DIAGNOSIS | WAITING_APPROVAL | IN_REPAIR | QUALITY_CHECK | READY | DELIVERED | CANCELLED
  status       String    @default("RECEIVED")
  estimatedAt  DateTime?
  deliveredAt  DateTime?
  // Momento en que el cliente aprobó el presupuesto (con su PIN de costos)
  approvedAt   DateTime?
  // Total (centavos) que el cliente aprobó; null si no hay aprobación vigente
  approvedTotalCents Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items   WorkOrderItem[]
  updates ProgressUpdate[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@index([vehicleId])
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  // LABOR | PART
  kind        String
  description String
  quantity    Int       @default(1)
  // Centavos, evita flotantes
  unitCents   Int
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
}

model ProgressUpdate {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  message     String
  // Estado de la orden al momento del avance
  status      String
  photoUrl    String?
  // Visible en la página pública de seguimiento
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([workOrderId, createdAt])
}
